{
  "name": "jb-payment-input",
  "description": "payment input web component",
  "type": "module",
  "author": {
		"name": "mohammad javad bathaei",
		"email": "javadbat@gmail.com"
	},
  "sideEffects": true,
  "keywords": [
    "jb",
    "jb-payment-input",
    "number input",
    "payment input",
    "card number",
    "shaba",
    "شبا",
    "شماره کارت",
    "iran bank",
    "web component",
    "react"
  ],
  "version": "3.5.0",
  "bugs": "https://github.com/javadbat/jb-payment-input/issues",
  "license": "MIT",
  "files": [
    "LICENSE",
    "README.md",
    "web-component/custom-elements.json",
    "web-component/lib/",
    "web-component/dist/",
    "bank-indicator/",
    "bank-indicator/dist/",
    "react/",
    "react/dist/",
    "bank-indicator/react/",
    "bank-indicator/react/dist/"
  ],
  "main": "index.js",
  "types": "./web-component/dist/jb-payment-input.d.ts",
  "exports": {
    ".": {
      "types": "./web-component/dist/jb-payment-input.d.ts",
      "default": "./index.js"
    },
    "./react": {
      "types": "./react/dist/JBPaymentInput.d.ts",
      "default": "./react/index.js"
    },
    "./bank-indicator": {
      "types": "./bank-indicator/dist/bank-indicator.d.ts",
      "default": "./bank-indicator/index.js"
    },
    "./bank-indicator/react": {
      "types": "./bank-indicator/react/dist/BankIndicator.d.ts",
      "default": "./bank-indicator/react/index.js"
    },
    "./*": "./*"
  },
  "customElements": "web-component/custom-elements.json",
  "repository": {
		"type": "git",
		"url": "https://github.com/javadbat/jb-payment-input.git"
  },
  "dependencies": {
    "jb-input": "^3.17.0",
    "jb-core":"^0.35.0",
    "jb-validation":"^1.0.0"
  },
  "devDependencies": {
    "jb-form":"^0.12.0"
  }
}
